local customBaseCFrame = nil

local function getMyBasePos()
    if customBaseCFrame then return customBaseCFrame.Position end

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Model") then
            local lower = string.lower(obj.Name)
            if string.find(lower, string.lower(player.Name)) or obj:GetAttribute("Owner") == player.Name then
                local p = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart", true)
                if p then
                    customBaseCFrame = p.CFrame + Vector3.new(0, 4, 0)
                    return customBaseCFrame.Position
                end
            end
        end
    end

    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("TextLabel") and (string.find(string.lower(v.Text), "safe zone") or string.find(string.lower(v.Text), "nest") or string.find(string.lower(v.Text), "base")) then
            local p = v:FindFirstAncestorWhichIsA("BasePart") or v.Adornee
            if p then
                customBaseCFrame = p.CFrame + Vector3.new(0, 4, 0)
                return customBaseCFrame.Position
            end
        end
    end

    local spawn = workspace:FindFirstChildWhichIsA("SpawnLocation", true)
    return spawn and spawn.Position or Vector3.new(0, 10, 0)
end

-- Collect coordinates of ALL player ranches/nests
local allBasesCache = {}
local lastBaseScan = 0
local function getAllBasePositions()
    if tick() - lastBaseScan < 4 and #allBasesCache > 0 then
        return allBasesCache
    end
    lastBaseScan = tick()
    allBasesCache = {}

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Model") then
            local lower = string.lower(obj.Name)
            if string.find(lower, "nest") or string.find(lower, "plot") or string.find(lower, "safe zone") or string.find(lower, "base") or string.find(lower, "ranch") then
                local p = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart", true)
                if p and not string.find(lower, "egg") then
                    table.insert(allBasesCache, p.Position)
                end
            end
        end
    end
    return allBasesCache
end

-- Teleport Player AND Pet Mount together
local function teleportPlayerAndMount(targetCFrame)
    stabilize()
    if not character then return end

    local hum = character:FindFirstChildWhichIsA("Humanoid")
    if hum and hum.SeatPart then
        local mountModel = hum.SeatPart:FindFirstAncestorWhichIsA("Model")
        if mountModel then
            mountModel:PivotTo(targetCFrame)
        end
    end

    character:PivotTo(targetCFrame)
    if character:FindFirstChild("HumanoidRootPart") then
        character.HumanoidRootPart.CFrame = targetCFrame
        character.HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
        character.HumanoidRootPart.AssemblyAngularVelocity = Vector3.zero
    end
    stabilize()
end

