-- Base / Safe Zone Detection
local cachedMyBase = nil
local function getMyBasePos()
    if cachedMyBase then return cachedMyBase end

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Model") then
            local lower = string.lower(obj.Name)
            if string.find(lower, string.lower(player.Name)) or obj:GetAttribute("Owner") == player.Name then
                local p = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart", true)
                if p then
                    cachedMyBase = p.Position
                    return cachedMyBase
                end
            end
        end
    end

    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("TextLabel") and (string.find(string.lower(v.Text), "safe zone") or string.find(string.lower(v.Text), "nest") or string.find(string.lower(v.Text), "base")) then
            local p = v:FindFirstAncestorWhichIsA("BasePart") or v.Adornee
            if p then
                cachedMyBase = p.Position
                return cachedMyBase
            end
        end
    end

    local spawn = workspace:FindFirstChildWhichIsA("SpawnLocation", true)
    return spawn and spawn.Position or Vector3.new(0, 10, 0)
end

-- Collect coordinates of ALL player bases/plots/ranches
local function getAllBasePositions()
    local positions = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Model") then
            local lower = string.lower(obj.Name)
            if string.find(lower, "nest") or string.find(lower, "plot") or string.find(lower, "safe zone") or string.find(lower, "base") or string.find(lower, "ranch") then
                local p = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart", true)
                if p and not string.find(lower, "egg") then
                    table.insert(positions, p.Position)
                end
            end
        end
    end
    return positions
end

-- Strict Wild Egg Checker (Ignores ranch and player eggs)
local function isWildUnownedEgg(model, primaryPart)
    if not model or not primaryPart then return false end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character and model:IsDescendantOf(plr.Character) then return false end
        if plr:FindFirstChild("Backpack") and model:IsDescendantOf(plr.Backpack) then return false end
    end

    if model:GetAttribute("Owner") ~= nil and model:GetAttribute("Owner") ~= "" then return false end
    if model:GetAttribute("Claimed") == true or model:GetAttribute("Stolen") == true then return false end

    local allBases = getAllBasePositions()
    for _, bPos in ipairs(allBases) do
        if (primaryPart.Position - bPos).Magnitude <= 45 then
            return false
        end
    end

    return true
end

