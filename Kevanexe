    ["divine"]    = {Tier = "Divine",    Rank = 7,  Color = Color3.fromRGB(255, 215, 0)},
    ["ethereal"]  = {Tier = "Ethereal",  Rank = 6,  Color = Color3.fromRGB(255, 120, 20)},
    ["mythic"]    = {Tier = "Mythic",    Rank = 5,  Color = Color3.fromRGB(180, 70, 255)},
