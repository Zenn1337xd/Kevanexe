}

-- Common Junk Blacklist
local JUNK_FILTER = {"white egg", "tim", "richie", "common", "basic", "eventboost", "standard"}

local function inspectRareWildEgg(model)
    if not model or not model.Parent then return nil end

    local primary = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
    if not primary then return nil end

    -- Check if it's wild and unowned
    if not isWildUnownedEgg(model, primary) then return nil end

    local eggName = model.Name
    local eggWeight = ""
    local foundText = ""

    for _, desc in ipairs(model:GetDescendants()) do
        if desc:IsA("TextLabel") and desc.Text ~= "" and desc.Visible then
            local txt = desc.Text
            local lTxt = string.lower(txt)
            foundText = foundText .. " " .. lTxt

            local kgMatch = string.match(txt, "%d+%.?%d*%s*[kK]?[gG]%s*[kK]?[gG]?")
            if kgMatch and eggWeight == "" then
                eggWeight = kgMatch
            end

            if string.find(lTxt, "egg") and not string.find(lTxt, "distance") then
                eggName = txt
            end
        end
    end

    if eggWeight == "" then
        eggWeight = model:GetAttribute("Weight") or model:GetAttribute("KG") or "Standard"
    end

    local combined = string.lower(eggName .. " " .. model.Name .. " " .. foundText)

    -- Ignore all common junk eggs
    for _, junk in ipairs(JUNK_FILTER) do
        if string.find(combined, junk) and not (string.find(combined, "divine") or string.find(combined, "blackhole") or string.find(combined, "volcano") or string.find(combined, "eternal") or string.find(combined, "secret")) then
            return nil
        end
    end

    -- Match strict rare tier
    local foundTier = nil
    local foundRank = 0
    local foundColor = nil

    for key, data in pairs(RARITY_RANKS) do
        if string.find(combined, key) then
            if data.Rank > foundRank then
                foundTier = data.Tier
                foundRank = data.Rank
                foundColor = data.Color
            end
        end
    end

    -- Only return high-tier eggs (Divine, Blackhole, Volcano, Eternal, Secret, Mythic, Legendary)
    if not foundTier or foundRank < 4 then
        return nil
    end

    return {
        Model = model,
        Part = primary,
        Name = eggName,
        Weight = tostring(eggWeight),
        Tier = foundTier,
        Rank = foundRank,
        Color = foundColor
    }
end

local function scanAllRareWildEggs()
    local results = {}
    local processedModels = {}
    local root = character and character:FindFirstChild("HumanoidRootPart")

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and not processedModels[obj] then
            local lName = string.lower(obj.Name)
            local hasPrompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)

            if string.find(lName, "egg") or hasPrompt then
                processedModels[obj] = true
                local data = inspectRareWildEgg(obj)
                if data then
                    -- Convert studs to meters
                    local distMeters = root and math.floor((root.Position - data.Part.Position).Magnitude * 0.28) or 0
                    -- 10,000m Maximum Distance Filter
                    if distMeters <= 10000 then
                        data.Distance = distMeters
                        table.insert(results, data)
                    end
                end
            end
        end
    end

    table.sort(results, function(a, b)
        if a.Rank ~= b.Rank then return a.Rank > b.Rank end
        return a.Distance < b.Distance
    end)
    return results
end

