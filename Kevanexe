-- Common Junk Blacklist
local JUNK_EGG_NAMES = {"white egg", "tim", "richie", "common egg", "basic egg", "uncommon egg"}

local function isUnownedWildEgg(model, primaryPart)
    if not model or not primaryPart or not model.Parent then return false end

    -- Ignore if attached to any player or mount
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character and (model:IsDescendantOf(plr.Character) or primaryPart:IsDescendantOf(plr.Character)) then
            return false
        end
        if plr:FindFirstChild("Backpack") and model:IsDescendantOf(plr.Backpack) then
            return false
        end
    end

    -- Ignore if egg is attached to a weld/mount
    for _, child in ipairs(model:GetDescendants()) do
        if child:IsA("Weld") or child:IsA("WeldConstraint") or child:IsA("Motor6D") then
            local p0, p1 = child.Part0, child.Part1
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr.Character then
                    if (p0 and p0:IsDescendantOf(plr.Character)) or (p1 and p1:IsDescendantOf(plr.Character)) then
                        return false
                    end
                end
            end
        end
    end

    local owner = model:GetAttribute("Owner") or model:GetAttribute("Holder")
    if owner and owner ~= "" then return false end
    if model:GetAttribute("Claimed") == true or model:GetAttribute("Stolen") == true then return false end

    -- Ignore if in any base or ranch
    local allBases = getAllBasePositions()
    for _, bPos in ipairs(allBases) do
        if (primaryPart.Position - bPos).Magnitude <= 40 then
            return false
        end
    end

    -- Ignore if under character/mount
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if root and (root.Position - primaryPart.Position).Magnitude < 16 then
        return false
    end

    return true
end

local function inspectRareEgg(model)
    if not model or not model.Parent then return nil end

    local primary = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
    if not primary then return nil end

    if not isUnownedWildEgg(model, primary) then return nil end

    local eggName = model.Name
    local eggWeight = ""
    local foundText = ""

    for _, desc in ipairs(model:GetDescendants()) do
        if desc:IsA("TextLabel") and desc.Text ~= "" and desc.Visible then
            local txt = desc.Text
            local lTxt = string.lower(txt)
            foundText = foundText .. " " .. lTxt

            -- Matches weights: 8.73 KG, 73K KG, 370.12K KG, 46.53 KG
            local kgMatch = string.match(txt, "%d+%.?%d*%s*[kKmMbB]?[gG]")
            if kgMatch and eggWeight == "" then
                eggWeight = kgMatch
            end

            if string.find(lTxt, "egg") and not string.find(lTxt, "distance") then
                eggName = txt
            end
        end
    end

    if eggWeight == "" then
        eggWeight = model:GetAttribute("Weight") or model:GetAttribute("KG") or "Standard"
    end

    local combined = string.lower(eggName .. " " .. model.Name .. " " .. foundText)

    -- Filter out common base eggs
    for _, junk in ipairs(JUNK_EGG_NAMES) do
        if string.find(combined, junk) and not (
            string.find(combined, "blackhole") or string.find(combined, "cherub") or 
            string.find(combined, "volcano") or string.find(combined, "valcono") or
            string.find(combined, "eternal") or string.find(combined, "divine") or 
            string.find(combined, "secret")
        ) then
            return nil
        end
    end

    -- Match Rarity
    local foundTier = nil
    local foundRank = 0
    local foundColor = nil

    for key, data in pairs(RARITY_RANKS) do
        if string.find(combined, key) then
            if data.Rank > foundRank then
                foundTier = data.Tier
                foundRank = data.Rank
                foundColor = data.Color
            end
        end
    end

    -- Shows Cherub, Blackhole, Volcano, Divine, Eternal, Secret, Mythic
    if not foundTier or foundRank < 7 then
        return nil
    end

    return {
        Model = model,
        Part = primary,
        Name = eggName,
        Weight = tostring(eggWeight),
        Tier = foundTier,
        Rank = foundRank,
        Color = foundColor
    }
end

local function scanRareEggs()
    local results = {}
    local processed = {}
    local root = character and character:FindFirstChild("HumanoidRootPart")

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and not processed[obj] then
            local lName = string.lower(obj.Name)
            if string.find(lName, "egg") or obj:FindFirstChildWhichIsA("ProximityPrompt", true) then
                processed[obj] = true
                local data = inspectRareEgg(obj)
                if data then
                    local distM = root and math.floor((root.Position - data.Part.Position).Magnitude * 0.28) or 0
                    if distM <= 12000 then
                        data.Distance = distM
                        table.insert(results, data)
                    end
                end
            end
        end
    end

    table.sort(results, function(a, b)
        if a.Rank ~= b.Rank then return a.Rank > b.Rank end
        return a.Distance < b.Distance
    end)
    return results
end

