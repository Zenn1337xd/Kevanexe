-- 1-SECOND INSTANT STEAL PIPELINE
-- =======================================================
local autoStealEnabled = false
local isStealing = false

local function executeFastOneSecondSteal(eggData)
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root or not eggData.Part or not eggData.Part.Parent then return end

    isStealing = true
    local homePos = customBaseCFrame or CFrame.new(getMyBasePos() + Vector3.new(0, 4, 0))

    notify("⚡ 1s Steal", string.format("Snatching [%s] %s (%dm away)...", eggData.Tier, eggData.Name, eggData.Distance))

    -- Step 1: Snap player and mounted pet directly to egg
    teleportPlayerAndMount(eggData.Part.CFrame * CFrame.new(0, 3, 0))
    task.wait(0.12)

    -- Step 2: Fire prompts and interactions
    local prompt = eggData.Model:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then
        if fireproximityprompt then
            fireproximityprompt(prompt, 0)
        else
            prompt:InputHoldBegin()
            task.wait(0.15)
            prompt:InputHoldEnd()
        end
    end

    if firetouchinterest then
        pcall(function()
            firetouchinterest(root, eggData.Part, 0)
            task.wait(0.02)
            firetouchinterest(root, eggData.Part, 1)
        end)
    end
    task.wait(0.18)

    -- Step 3: Return directly back to base within 1 second
    teleportPlayerAndMount(homePos)
    removeESPForModel(eggData.Model)
    notify("Auto Steal Success", "Delivered " .. eggData.Name .. " [" .. eggData.Tier .. "] to Base!")

    task.wait(0.4)
    isStealing = false
end

-- Auto Steal Loop
task.spawn(function()
    while true do
        if autoStealEnabled and not isStealing then
            local eggs = scanRareEggs()
            for _, egg in ipairs(eggs) do
                executeFastOneSecondSteal(egg)
                task.wait(0.8)
                break
            end
        end
        task.wait(1)
    end
end)

