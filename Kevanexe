-- FLY & INSTANT STEAL
-- =======================================================
local autoStealEnabled = false
local instantStealEnabled = false
local isStealing = false

local function flyToDestination(targetCFrame, speedMultiplier)
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    stabilize()
    local distance = (root.Position - targetCFrame.Position).Magnitude
    local travelTime = math.clamp(distance / (400 * (speedMultiplier or 1)), 0.08, 0.45)

    local tweenInfo = TweenInfo.new(travelTime, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(root, tweenInfo, {CFrame = targetCFrame})
    tween:Play()
    tween.Completed:Wait()
    stabilize()
end

local function executeAutoSteal(eggData)
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root or not eggData.Part or not eggData.Part.Parent then return end

    isStealing = true
    local home = getMyBasePos()

    notify("🚀 Flying to Rare Egg", string.format("Approaching %s [%s] (%dm away)...", eggData.Name, eggData.Tier, eggData.Distance))

    flyToDestination(eggData.Part.CFrame * CFrame.new(0, 3.2, 0), 1)
    task.wait(0.1)

    local prompt = eggData.Model:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then
        if fireproximityprompt then
            fireproximityprompt(prompt, 0)
        else
            prompt:InputHoldBegin()
            task.wait(0.18)
            prompt:InputHoldEnd()
        end
    end
    if firetouchinterest then
        pcall(function()
            firetouchinterest(root, eggData.Part, 0)
            task.wait(0.04)
            firetouchinterest(root, eggData.Part, 1)
        end)
    end
    task.wait(0.25)

    flyToDestination(CFrame.new(home + Vector3.new(0, 5, 0)), 1.5)
    notify("Auto Steal Success", "Delivered " .. eggData.Name .. " [" .. eggData.Tier .. "] to Base!")
    task.wait(0.4)
    isStealing = false
end

local function executeInstantSteal(eggData)
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root or not eggData.Part or not eggData.Part.Parent then return end

    isStealing = true
    local home = getMyBasePos()

    stabilize()
    root.CFrame = eggData.Part.CFrame * CFrame.new(0, 2.5, 0)

    local prompt = eggData.Model:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt and fireproximityprompt then
        fireproximityprompt(prompt, 0)
    end
    if firetouchinterest then
        pcall(function()
            firetouchinterest(root, eggData.Part, 0)
            firetouchinterest(root, eggData.Part, 1)
        end)
    end

    root.CFrame = CFrame.new(home + Vector3.new(0, 4, 0))
    stabilize()

    notify("⚡ INSTANT STEAL", "Snatched " .. eggData.Name .. " (" .. eggData.Tier .. ")!")
    task.wait(0.2)
    isStealing = false
end

task.spawn(function()
    while true do
        if (autoStealEnabled or instantStealEnabled) and not isStealing then
            local eggs = scanAllRareWildEggs()
            for _, egg in ipairs(eggs) do
                if instantStealEnabled then
                    executeInstantSteal(egg)
                else
                    executeAutoSteal(egg)
                end
                task.wait(1)
                break
            end
        end
        task.wait(1.2)
    end
end)

