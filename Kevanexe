-- Base / Nest Detection
local cachedBase = nil
local function getMyBasePos()
    if cachedBase then return cachedBase end

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Model") then
            local lower = string.lower(obj.Name)
            if string.find(lower, string.lower(player.Name)) or obj:GetAttribute("Owner") == player.Name then
                local p = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart", true)
                if p then
                    cachedBase = p.Position
                    return cachedBase
                end
            end
        end
    end

    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("TextLabel") and (string.find(string.lower(v.Text), "safe zone") or string.find(string.lower(v.Text), "nest") or string.find(string.lower(v.Text), "base")) then
            local p = v:FindFirstAncestorWhichIsA("BasePart") or v.Adornee
            if p then
                cachedBase = p.Position
                return cachedBase
            end
        end
    end

    local spawn = workspace:FindFirstChildWhichIsA("SpawnLocation", true)
    return spawn and spawn.Position or Vector3.new(0, 10, 0)
end

local function isInsideMyBase(pos)
    return (pos - getMyBasePos()).Magnitude <= 40
end

