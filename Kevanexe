local RARITY_RANKS = {
    ["blackhole"] = {Tier = "Blackhole", Rank = 11, Color = Color3.fromRGB(150, 0, 255)},
    ["volcano"]   = {Tier = "Volcano",   Rank = 10, Color = Color3.fromRGB(255, 65, 0)},
