local BASE_TRASH_NAMES = {"white egg", "tim", "richie", "common egg", "basic egg", "uncommon egg"}

local function isUnownedWildEgg(model, primaryPart)
    if not model or not primaryPart or not model.Parent then return false end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character and (model:IsDescendantOf(plr.Character) or primaryPart:IsDescendantOf(plr.Character)) then
            return false
        end
        if plr:FindFirstChild("Backpack") and model:IsDescendantOf(plr.Backpack) then
            return false
        end
    end

    for _, child in ipairs(model:GetDescendants()) do
        if child:IsA("Weld") or child:IsA("WeldConstraint") or child:IsA("Motor6D") then
            local p0, p1 = child.Part0, child.Part1
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr.Character then
                    if (p0 and p0:IsDescendantOf(plr.Character)) or (p1 and p1:IsDescendantOf(plr.Character)) then
                        return false
                    end
                end
            end
        end
    end

    local owner = model:GetAttribute("Owner") or model:GetAttribute("Holder")
    if owner and owner ~= "" then return false end
    if model:GetAttribute("Claimed") == true or model:GetAttribute("Stolen") == true then return false end

    -- Ignore eggs inside your own ranch
    local myBase = getMyRanchPosition()
    if (primaryPart.Position - myBase).Magnitude <= 52 then
        return false
    end

    -- Ignore eggs in other players' ranches
    local allBases = getAllBases()
    for _, bPos in ipairs(allBases) do
        if (primaryPart.Position - bPos).Magnitude <= 40 then
            return false
        end
    end

    local root = character and character:FindFirstChild("HumanoidRootPart")
    if root and (root.Position - primaryPart.Position).Magnitude < 18 then
        return false
    end

    return true
end

local function inspectAnyMapEgg(model)
    if not model or not model.Parent then return nil end

    local primary = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
    if not primary then return nil end

    if not isUnownedWildEgg(model, primary) then return nil end

    local eggName = model.Name
    local eggWeight = ""
    local foundText = ""

    for _, desc in ipairs(model:GetDescendants()) do
        if desc:IsA("TextLabel") and desc.Text ~= "" and desc.Visible then
            local txt = desc.Text
            local lTxt = string.lower(txt)
            foundText = foundText .. " " .. lTxt

            -- Matches weights: 788.50 KG, 11.44 KG, 8.73 KG, 73K KG
            local kgMatch = string.match(txt, "%d+%.?%d*%s*[kKmMbBtT]?[gG]")
            if kgMatch and eggWeight == "" then
                eggWeight = kgMatch
            end

            if string.find(lTxt, "egg") and not string.find(lTxt, "distance") then
                eggName = txt
            end
        end
    end

    if eggWeight == "" then
        eggWeight = model:GetAttribute("Weight") or model:GetAttribute("KG") or "Standard"
    end

    local combined = string.lower(eggName .. " " .. model.Name .. " " .. foundText)

    -- Filter out basic starter eggs
    for _, junk in ipairs(BASE_TRASH_NAMES) do
        if string.find(combined, junk) and not (
            string.find(combined, "solaris") or string.find(combined, "bloom") or
            string.find(combined, "galaxy") or string.find(combined, "blackhole") or
            string.find(combined, "cherub") or string.find(combined, "volcano") or
            string.find(combined, "valcono") or string.find(combined, "eternal") or
            string.find(combined, "divine") or string.find(combined, "ethereal") or
            string.find(combined, "secret")
        ) then
            return nil
        end
    end

    local foundTier = "Rare"
    local foundRank = 5
    local foundColor = Color3.fromRGB(0, 170, 255)

    for key, data in pairs(RARITY_DATA) do
        if string.find(combined, key) then
            if data.Rank > foundRank then
                foundTier = data.Tier
                foundRank = data.Rank
                foundColor = data.Color
            end
        end
    end

    return {
        Model = model,
        Part = primary,
        Name = eggName,
        Weight = tostring(eggWeight),
        Tier = foundTier,
        Rank = foundRank,
        Color = foundColor
    }
end

local function scanAllMapEggs()
    local results = {}
    local processed = {}
    local root = character and character:FindFirstChild("HumanoidRootPart")

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and not processed[obj] then
            local lName = string.lower(obj.Name)
            if string.find(lName, "egg") or obj:FindFirstChildWhichIsA("ProximityPrompt", true) then
                processed[obj] = true
                local data = inspectAnyMapEgg(obj)
                if data then
                    local distM = root and math.floor((root.Position - data.Part.Position).Magnitude * 0.28) or 0
                    if distM <= 15000 then
                        data.Distance = distM
                        table.insert(results, data)
                    end
                end
            end
        end
    end

    table.sort(results, function(a, b)
        if a.Rank ~= b.Rank then return a.Rank > b.Rank end
        return a.Distance < b.Distance
    end)
    return results
end

-- =======================================================
-- ANTI CODE AT-3786 STEAL LOGIC
-- =======================================================
local autoStealEnabled = false
local isStealing = false

local function segmentedBypassFly(startPos, endPos, totalDistance)
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local minSafeDuration = math.clamp(totalDistance / 1100, 0.75, 2.2)
    local steps = 4
    local stepDuration = minSafeDuration / steps

    for i = 1, steps do
        local alpha = i / steps
        local intermediatePos = startPos:Lerp(endPos, alpha)
        local targetCF = CFrame.new(intermediatePos + Vector3.new(0, math.sin(alpha * math.pi) * 8, 0))

        teleportPlayerAndMount(targetCF)
        task.wait(stepDuration)
    end

    teleportPlayerAndMount(CFrame.new(endPos))
    wipeVelocities()
end

local function executeSafeBypassSteal(eggData)
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root or not eggData.Part or not eggData.Part.Parent then return end

    isStealing = true
    local homePos = customBaseCFrame or CFrame.new(getMyRanchPosition() + Vector3.new(0, 3, 0))

    notify("⚡ Snatching Egg", string.format("[%s] %s (%dm away)...", eggData.Tier, eggData.Name, eggData.Distance))

    teleportPlayerAndMount(eggData.Part.CFrame * CFrame.new(0, 3.2, 0))
    task.wait(0.15)

    local prompt = eggData.Model:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then
        if fireproximityprompt then
            fireproximityprompt(prompt, 0)
        else
            prompt:InputHoldBegin()
            task.wait(0.2)
            prompt:InputHoldEnd()
        end
    end

    if firetouchinterest then
        pcall(function()
            firetouchinterest(root, eggData.Part, 0)
            task.wait(0.04)
            firetouchinterest(root, eggData.Part, 1)
        end)
    end

    task.wait(0.35)

    local eggPos = eggData.Part.Position
    local basePos = homePos.Position
    local dist = (eggPos - basePos).Magnitude

    segmentedBypassFly(eggPos, basePos, dist)
    task.wait(0.35)

    notify("Auto Steal Success", "Delivered " .. eggData.Name .. " [" .. eggData.Tier .. "] to Base!")
    task.wait(0.5)
    isStealing = false
end

