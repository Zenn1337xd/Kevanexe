local function makeToggle(labelText, defaultState, callback, icon, isGold)
    local state = defaultState
    local card = Instance.new("Frame")
    card.Size = UDim2.new(0.96, 0, 0, 40)
    card.BackgroundColor3 = THEME.Card
    card.Parent = scrollList
    Instance.new("UICorner", card).CornerRadius = UDim.new(0, 6)

    if isGold then
        local st = Instance.new("UIStroke", card)
        st.Color = THEME.Gold
        st.Thickness = 1.2
    end

    local offset = 10
    if icon then
        local ic = Instance.new("TextLabel")
        ic.Size = UDim2.new(0, 24, 1, 0)
        ic.Position = UDim2.new(0, 8, 0, 0)
        ic.BackgroundTransparency = 1
        ic.Text = icon
        ic.TextSize = 14
        ic.Parent = card
        offset = 34
    end

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(0.65, 0, 1, 0)
    lbl.Position = UDim2.new(0, offset, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = labelText
    lbl.TextColor3 = isGold and THEME.Gold or THEME.TextPrimary
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextSize = 10
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = card

    local switch = Instance.new("TextButton")
    switch.Size = UDim2.new(0, 42, 0, 22)
    switch.Position = UDim2.new(1, -50, 0.5, -11)
    switch.BackgroundColor3 = state and (isGold and THEME.Gold or THEME.ToggleOn) or THEME.ToggleOff
    switch.Text = ""
    switch.AutoButtonColor = false
    switch.Parent = card
    Instance.new("UICorner", switch).CornerRadius = UDim.new(1, 0)

    local dot = Instance.new("Frame")
    dot.Size = UDim2.new(0, 16, 0, 16)
    dot.Position = state and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
    dot.BackgroundColor3 = THEME.TextPrimary
    dot.Parent = switch
    Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

    switch.MouseButton1Click:Connect(function()
        state = not state
        switch.BackgroundColor3 = state and (isGold and THEME.Gold or THEME.ToggleOn) or THEME.ToggleOff
        dot.Position = state and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
        callback(state)
    end)
    return card
end

local function makeSliderCard(titlePrefix, currentVal, minVal, maxVal, unit, presets, onUpdate)
    local card = Instance.new("Frame")
    card.Size = UDim2.new(0.96, 0, 0, 68)
    card.BackgroundColor3 = THEME.Card
    card.Parent = scrollList
    Instance.new("UICorner", card).CornerRadius = UDim.new(0, 6)

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -16, 0, 18)
    title.Position = UDim2.new(0, 8, 0, 4)
    title.BackgroundTransparency = 1
    title.Text = string.format("%s: %d %s", titlePrefix, currentVal, unit)
    title.TextColor3 = THEME.Accent
    title.Font = Enum.Font.GothamBold
    title.TextSize = 11
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = card

    local track = Instance.new("TextButton")
    track.Size = UDim2.new(0.94, 0, 0, 6)
    track.Position = UDim2.new(0.03, 0, 0, 26)
    track.BackgroundColor3 = THEME.ToggleOff
    track.Text = ""
    track.AutoButtonColor = false
    track.Parent = card
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame")
    local initRatio = math.clamp((currentVal - minVal) / (maxVal - minVal), 0, 1)
    fill.Size = UDim2.new(initRatio, 0, 1, 0)
    fill.BackgroundColor3 = THEME.Accent
    fill.BorderSizePixel = 0
    fill.Parent = track
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local function applyValue(val)
        currentVal = math.clamp(math.floor(val), minVal, maxVal)
        local ratio = (currentVal - minVal) / (maxVal - minVal)
        fill.Size = UDim2.new(ratio, 0, 1, 0)
        title.Text = string.format("%s: %d %s", titlePrefix, currentVal, unit)
        onUpdate(currentVal)
    end

    local dragging = false
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            local rel = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            applyValue(minVal + (rel * (maxVal - minVal)))
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local rel = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            applyValue(minVal + (rel * (maxVal - minVal)))
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    local pRow = Instance.new("Frame")
    pRow.Size = UDim2.new(0.94, 0, 0, 22)
    pRow.Position = UDim2.new(0.03, 0, 0, 38)
    pRow.BackgroundTransparency = 1
    pRow.Parent = card

    local count = #presets
    for i, pVal in ipairs(presets) do
        local pBtn = Instance.new("TextButton")
        pBtn.Size = UDim2.new((1 / count) - 0.02, 0, 1, 0)
        pBtn.Position = UDim2.new((i - 1) * (1 / count) + 0.01, 0, 0, 0)
        pBtn.BackgroundColor3 = Color3.fromRGB(34, 37, 48)
        pBtn.Text = tostring(pVal)
        pBtn.TextColor3 = THEME.TextMuted
        pBtn.Font = Enum.Font.GothamBold
        pBtn.TextSize = 10
        pBtn.Parent = pRow
        Instance.new("UICorner", pBtn).CornerRadius = UDim.new(0, 4)
        pBtn.MouseButton1Click:Connect(function()
            applyValue(pVal)
        end)
    end
end

