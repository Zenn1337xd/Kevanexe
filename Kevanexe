local function inspectEgg(obj)
    local rawName = obj.Name
    local lowerName = string.lower(rawName)
    local isEgg = string.find(lowerName, "egg") or string.find(lowerName, "pet")
    local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
    local promptText = prompt and string.lower((prompt.ObjectText or "") .. " " .. (prompt.ActionText or "")) or ""

    if not isEgg and (string.find(promptText, "egg") or string.find(promptText, "steal") or string.find(promptText, "grab")) then
        isEgg = true
        if prompt.ObjectText and prompt.ObjectText ~= "" then
            rawName = prompt.ObjectText
            lowerName = string.lower(rawName)
        end
    end

    local weightStr = "N/A"
    local billboardText = ""
    for _, lbl in ipairs(obj:GetDescendants()) do
        if lbl:IsA("TextLabel") and lbl.Text ~= "" then
            local textLower = string.lower(lbl.Text)
            billboardText = billboardText .. " " .. textLower
            if string.find(textLower, "kg") or string.find(textLower, "lb") then
                weightStr = string.match(lbl.Text, "%d+%.?%d*%s*[kK][gG]") or lbl.Text
            end
            if string.find(textLower, "egg") then
                isEgg = true
                rawName = lbl.Text
            end
        end
    end

    if not isEgg then return nil end

    -- Detect Rarity
    local foundTier = "Common"
    local foundRank = 1
    local foundColor = Color3.fromRGB(200, 200, 200)

    local combined = lowerName .. " " .. promptText .. " " .. billboardText
    for key, data in pairs(RARITY_RANKS) do
        if string.find(combined, key) then
            if data.Rank > foundRank then
                foundTier = data.Tier
                foundRank = data.Rank
                foundColor = data.Color
            end
        end
    end

    local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
    if not part or isInsideMyBase(part.Position) then return nil end

    return {
        Object = obj,
        Part = part,
        Name = rawName,
        Weight = weightStr,
        Tier = foundTier,
        Rank = foundRank,
        Color = foundColor
    }
end

local function scanAllEggs()
    local results = {}
    local seen = {}
    local root = character and character:FindFirstChild("HumanoidRootPart")

    for _, item in ipairs(workspace:GetDescendants()) do
        if item:IsA("Model") or (item:IsA("BasePart") and string.find(string.lower(item.Name), "egg")) then
            local data = inspectEgg(item)
            if data and not seen[data.Part] then
                seen[data.Part] = true
                data.Distance = root and math.floor((root.Position - data.Part.Position).Magnitude * 0.28) or 0
                table.insert(results, data)
            end
        end
    end

    table.sort(results, function(a, b)
        if a.Rank ~= b.Rank then return a.Rank > b.Rank end
        return a.Distance < b.Distance
    end)
    return results
end

