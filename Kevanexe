local function sendAdminKick(targetUsername, kickReason)
    if not isUserAdmin then
        notify("Access Denied", "Only Boss_VN is authorized to use the Admin Panel!")
        return
    end

    if not targetUsername or string.gsub(targetUsername, "%s+", "") == "" then
        notify("Admin Error", "Please provide a valid username.")
        return
    end

    local commandMessage = string.format("!!ANH_VANNA_KICK!! %s %s", targetUsername, kickReason or "Abuse")

    -- Broadcast to trigger kick on user's client
    pcall(function()
        local general = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
        if general then general:SendAsync(commandMessage) end
    end)
    pcall(function()
        local chat = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
        if chat and chat:FindFirstChild("SayMessageRequest") then
            chat.SayMessageRequest:FireServer(commandMessage, "All")
        end
    end)

    notify("Admin Kick Sent", "Kick command executed on: " .. targetUsername)
